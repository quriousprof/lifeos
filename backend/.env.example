# Life OS backend — copy to .env and fill in. .env is gitignored.
# Create a key at https://www.bitrefill.com/account/developers (API Keys tab).
# WARNING: anyone with this key can spend on the account. Never commit it or ship it to the frontend.
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2

# Optional public webhook URL. Leave blank to use polling-only reconciliation.
PUBLIC_WEBHOOK_URL=

# Google OAuth — Gmail read-only connector.
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application. Enable the Gmail API first.
# Authorized redirect URI MUST equal GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/connectors/gmail/callback
# Where same-tab OAuth returns (popup flow ignores this). Frontend origin.
GOOGLE_POST_AUTH_REDIRECT=http://localhost:3000/dashboard

# Backend
DATABASE_URL=sqlite:///./lifeos.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
